{
  "name": "gmail-postman",
  "description": "Gmail 助手 · Cloudflare Workers Gmail 实时聚合与推送系统",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "setup:deploy": "node scripts/deploy.mjs",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply gmail-postman-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply gmail-postman-db --remote"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "postal-mime": "^2.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.166.0"
  }
}
